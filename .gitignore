*.iml
.gradle/
build/
*/build/
# 例外：core/build 是**源码包**（Android 构建引擎），不是 Gradle 产物，必须入库。
# 不加这条的话 git 会一直静默忽略它——2026-10-28 就是这样让远端多出 7 个本地不认识的
# 文件（上一轮走 REST API 推的，绕过了 gitignore）。
!app/src/main/java/com/example/agentkit/core/build/
local.properties
.idea/
captures/
.DS_Store
*.apk
!gradle/wrapper/gradle-wrapper.jar

# llama.cpp 源码（MIT）在构建时由 scripts/fetch-llama.sh 拉取固定 tag，不进仓库
app/src/main/cpp/llama.cpp/

# CMake/native 构建中间产物
app/.cxx/

# W-13：内置 Shizuku APK 由 CI 构建时下载，不进仓库
app/src/main/assets/shizuku.apk

# x86_64 容器测试套件（~8MB 的 rootfs + proot），由 scripts/fetch-x86-testkit.sh 拉取，
# 只用于 `-Px86Rootfs=true` 的本地调试包，不进仓库
app/src/debugX86/assets/

# QA 全套 runner 的日志目录（run-all.sh 生成，勿入库）
qa-logs/
