<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 路径配置：作品库（filesDir/media/outputs/）的文件经 content:// URI
  分享给系统相册/播放器。零依赖（androidx.core 自带），不暴露 filesDir 全貌。
-->
<paths>
    <files-path name="media_outputs" path="media/outputs/" />
    <files-path name="builds" path="builds/" />
    <!-- hotfix29：会话导出的 .md 落 cacheDir/exports/，经同一 FileProvider 分享 -->
    <cache-path name="exports" path="exports/" />
    <!-- W-13：内置 Shizuku APK 解出到 cacheDir/shizuku/，经同一 FileProvider 交给系统安装器 -->
    <cache-path name="shizuku" path="shizuku/" />
</paths>
